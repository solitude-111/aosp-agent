{
  "version": 1,
  "source_root": "/srv/aosp/source",
  "donor_root": "/srv/aosp/donor-git",
  "cache_root": "/srv/aosp-agent/cache",
  "isolation_root": "/srv/aosp-agent/isolation",
  "run_root": "/srv/aosp-agent/runs",
  "manifest_origin": "https://android.googlesource.com/platform/manifest",
  "manifest_name": "default.xml",
  "allowed_upstreams": ["https://android.googlesource.com"],
  "donor_map": {},
  "credential_reference": "codex:default",
  "agent": {
    "model": "deepseek-flash",
    "model_provider": "deepseek",
    "locate_first": true,
    "auto_validation": true,
    "turn_timeout": 900,
    "max_projects": 12,
    "max_rounds": 3,
    "investigation_seconds": 900,
    "max_git_operations": 2000,
    "max_model_turns": 48,
    "max_read_bytes": 67108864,
    "max_output_bytes": 268435456,
    "case_timeout": 7200,
    "candidate_attempts": 6,
    "location_attempts": 3,
    "impact_attempts": 3,
    "report_corrections": 6,
    "max_stage_extensions": 1,
    "extension_seconds": 300
  },
  "preparation": {
    "allow_fetch": true,
    "local_command_timeout": 60,
    "fetch_timeout": 180,
    "max_fetches": 128,
    "max_ref_queries": 4096,
    "max_fetch_file_bytes": 536870912,
    "max_cache_bytes": 34359738368,
    "min_free_bytes": 2147483648,
    "max_seconds": 3600
  },
  "batch_limits": {"max_output_bytes": 1073741824},
  "retry_policy": {"max_terminal_retries": 1},
  "build": {"enabled": false}
}
